import json
import os
import sys
import agent
import agent.tasks

data = json.load(sys.stdin)

host = os.environ.get("HOST", "")
lets_encrypt = os.environ.get("LETS_ENCRYPT", "False") == "True"
http2https = os.environ.get("HTTP2HTTPS", "True") == "True"

default_traefik_id = agent.resolve_agent_id("traefik@node")
agent.assert_exp(default_traefik_id is not None, "Cannot find Traefik instance on current node")

response = agent.tasks.run(
    agent_id=default_traefik_id,
    action="set-route",
    data={
        "instance": os.environ["MODULE_ID"],
        "url": f'http://127.0.0.1:{os.environ["TCP_PORT"]}',
        "host": host,
        "lets_encrypt": lets_encrypt,
        "http2https": http2https,
    },
)
agent.assert_exp(response["exit_code"] == 0, "Failed to configure Traefik route")
