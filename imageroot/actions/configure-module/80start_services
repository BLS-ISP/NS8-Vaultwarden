set -e

# Redirect any output to the journal (stderr)
exec 1>&2

systemctl --user daemon-reload

# Enable and restart pod + child services explicitly in dependency order
systemctl --user enable vaultwarden.service vaultwarden-app.service

if [[ -n "${LDAP_DOMAIN}" ]]; then
    systemctl --user enable vaultwarden-ldap.service
    systemctl --user restart vaultwarden.service vaultwarden-app.service vaultwarden-ldap.service
else
    systemctl --user disable --now vaultwarden-ldap.service 2>/dev/null || true
    systemctl --user restart vaultwarden.service vaultwarden-app.service
fi
