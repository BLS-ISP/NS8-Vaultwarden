import json
import os
import sys
import agent
import agent.tasks

data = json.load(sys.stdin)

# Unbind LDAP user domains
try:
    agent.unbind_user_domains()
except Exception as ex:
    print(agent.SD_WARNING + f"Failed to unbind LDAP user domains: {ex}", file=sys.stderr)

# Find default traefik instance for current node
default_traefik_id = agent.resolve_agent_id("traefik@node")
if default_traefik_id is not None:
    agent.tasks.run(
        agent_id=default_traefik_id,
        action="delete-route",
        data={
            "instance": os.environ["MODULE_ID"],
        },
    )
