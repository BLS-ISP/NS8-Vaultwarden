import json
import os
import sys
import agent

request = json.load(sys.stdin)
original_environment = request.get("environment", {})

for evar in [
    "HOST",
    "HTTP2HTTPS",
    "LETS_ENCRYPT",
    "ADMIN_ENABLED",
    "SIGNUPS_ALLOWED",
    "SIGNUPS_VERIFY",
    "SIGNUPS_DOMAINS_WHITELIST",
    "INVITATIONS_ALLOWED",
    "SHOW_PASSWORD_HINT",
    "WEB_VAULT_ENABLED",
    "SENDS_ALLOWED",
    "EMERGENCY_ACCESS_ALLOWED",
    "ORG_EVENTS_ENABLED",
    "SMTP_FROM",
    "LDAP_DOMAIN",
    "LDAP_SYNC_INTERVAL",
    "LDAP_SEARCH_FILTER",
    "PUSH_ENABLED",
    "PUSH_INSTALLATION_ID",
    "PUSH_RELAY_URI",
    "PUSH_IDENTITY_URI",
]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()

# Migrate legacy secrets from older backups (<= 1.0.2) into secrets.env if not restored by Restic
secrets_path = "secrets.env"
if not os.path.exists(secrets_path):
    legacy_secrets = {
        k: original_environment.get(k, "")
        for k in ("ADMIN_PASSWORD", "ADMIN_TOKEN_HASH", "PUSH_INSTALLATION_KEY")
        if k in original_environment
    }
    if legacy_secrets:
        agent.write_envfile(secrets_path, legacy_secrets)
        os.chmod(secrets_path, 0o600)
