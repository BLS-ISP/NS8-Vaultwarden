import json
import os
import sys
import agent
import agent.tasks

request = json.load(sys.stdin)
renv = request.get("environment", {})

host = renv.get("HOST") or os.environ.get("HOST", "")
if host:
    try:
        ldap_sync_interval = int(renv.get("LDAP_SYNC_INTERVAL") or os.environ.get("LDAP_SYNC_INTERVAL") or 3600)
    except ValueError:
        ldap_sync_interval = 3600

    push_relay_uri = (
        renv.get("PUSH_RELAY_URI")
        or os.environ.get("PUSH_RELAY_URI")
        or "https://push.bitwarden.com"
    )
    default_identity_uri = (
        "https://identity.bitwarden.eu"
        if push_relay_uri.rstrip("/").endswith(".eu")
        else "https://identity.bitwarden.com"
    )
    push_identity_uri = (
        renv.get("PUSH_IDENTITY_URI")
        or os.environ.get("PUSH_IDENTITY_URI")
        or default_identity_uri
    )

    configure_retval = agent.tasks.run(
        agent_id=os.environ["AGENT_ID"],
        action="configure-module",
        data={
            "host": host,
            "http2https": renv.get("HTTP2HTTPS", os.environ.get("HTTP2HTTPS", "True")) == "True",
            "lets_encrypt": renv.get("LETS_ENCRYPT", os.environ.get("LETS_ENCRYPT", "False")) == "True",
            "admin_enabled": renv.get("ADMIN_ENABLED", os.environ.get("ADMIN_ENABLED", "True")) == "True",
            "admin_password": "",
            "signups_allowed": renv.get("SIGNUPS_ALLOWED", os.environ.get("SIGNUPS_ALLOWED", "False")) == "True",
            "signups_verify": renv.get("SIGNUPS_VERIFY", os.environ.get("SIGNUPS_VERIFY", "False")) == "True",
            "signups_domains_whitelist": renv.get(
                "SIGNUPS_DOMAINS_WHITELIST", os.environ.get("SIGNUPS_DOMAINS_WHITELIST", "")
            ),
            "invitations_allowed": renv.get(
                "INVITATIONS_ALLOWED", os.environ.get("INVITATIONS_ALLOWED", "True")
            ) == "True",
            "show_password_hint": renv.get(
                "SHOW_PASSWORD_HINT", os.environ.get("SHOW_PASSWORD_HINT", "False")
            ) == "True",
            "web_vault_enabled": renv.get(
                "WEB_VAULT_ENABLED", os.environ.get("WEB_VAULT_ENABLED", "True")
            ) == "True",
            "sends_allowed": renv.get("SENDS_ALLOWED", os.environ.get("SENDS_ALLOWED", "True")) == "True",
            "emergency_access_allowed": renv.get(
                "EMERGENCY_ACCESS_ALLOWED", os.environ.get("EMERGENCY_ACCESS_ALLOWED", "True")
            ) == "True",
            "org_events_enabled": renv.get(
                "ORG_EVENTS_ENABLED", os.environ.get("ORG_EVENTS_ENABLED", "False")
            ) == "True",
            "smtp_from": renv.get("SMTP_FROM", os.environ.get("SMTP_FROM", "")),
            "ldap_domain": renv.get("LDAP_DOMAIN", os.environ.get("LDAP_DOMAIN", "")),
            "ldap_sync_interval": ldap_sync_interval,
            "ldap_search_filter": renv.get("LDAP_SEARCH_FILTER", os.environ.get("LDAP_SEARCH_FILTER", "")),
            "push_enabled": renv.get("PUSH_ENABLED", os.environ.get("PUSH_ENABLED", "False")) == "True",
            "push_installation_id": renv.get(
                "PUSH_INSTALLATION_ID", os.environ.get("PUSH_INSTALLATION_ID", "")
            ),
            "push_installation_key": "",
            "push_relay_uri": push_relay_uri,
            "push_identity_uri": push_identity_uri,
        },
    )
    agent.assert_exp(configure_retval["exit_code"] == 0, "The configure-module subtask failed!")
