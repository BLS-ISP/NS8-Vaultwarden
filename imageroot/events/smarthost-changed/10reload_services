set -e
exec 1>&2

if systemctl --user is-active --quiet vaultwarden.service; then
    ../bin/write-config
    if [[ -n "${LDAP_DOMAIN}" ]]; then
        systemctl --user restart vaultwarden.service vaultwarden-app.service vaultwarden-ldap.service
    else
        systemctl --user restart vaultwarden.service vaultwarden-app.service
    fi
fi
