set -e

exec 1>&2

systemctl --user daemon-reload
systemctl --user try-restart vaultwarden.service

if [[ -n "${LDAP_DOMAIN}" ]] && systemctl --user is-active --quiet vaultwarden.service; then
    systemctl --user enable vaultwarden-ldap.service
    systemctl --user try-restart vaultwarden-ldap.service
fi
